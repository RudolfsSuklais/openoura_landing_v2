# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real keys.

# Resend API key — sends demo request emails.
# Get one at https://resend.com/api-keys (free tier: 3,000/mo, 100/day).
RESEND_API_KEY=re_your_key_here

# Inbox that receives demo requests.
CONTACT_EMAIL=rudolfs@openoura.com

# From address. Before openoura.com is verified in Resend, leave this
# default — `onboarding@resend.dev` works immediately for testing.
# After domain verification: change to "OpenOura <noreply@openoura.com>".
RESEND_FROM_EMAIL=OpenOura <onboarding@resend.dev>

# PostHog analytics (EU cloud for GDPR-friendly data residency).
# Project API key from posthog.com → Project Settings → API Keys.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# REQUIRED for WhatsApp button to render. Format: 371XXXXXXXX (no + or spaces).
# Example: Latvia +371 20 123 456 → 37120123456
# If unset or left at the fake fallback "37100000000", the button is hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=
